{
	"name": "disflow",
	"packageManager": "yarn@4.12.0",
	"author": {
		"name": "DisFlow Team"
	},
	"scripts": {
		"build": "turbo build",
		"test": "turbo test",
		"dev": "turbo build --filter=!web-application && yarn workspace web-application dev",
		"build:packages": "turbo build --filter=!web-application",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"tsdown": "^0.21.7",
		"turbo": "^2.6.3",
		"typescript": "^6.0.2",
		"vitest": "^4.1.6"
	},
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "1.3.0",
		"@types/node": "^25.0.3"
	}
}
